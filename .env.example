# Base Postgres (docker compose up -d)
DATABASE_URL=postgresql://questionnaire:questionnaire@localhost:5436/questionnaire

# Clé de l'API Anthropic (jamais dans un fichier suivi)
ANTHROPIC_API_KEY=

# Mot de passe de l'espace /admin
ADMIN_PASSWORD=

# Ports de dev (le front Vite relaie /api vers l'API)
API_PORT=3400
WEB_PORT=5190

# Adresse publique, pour les liens renvoyés par l'API (sinon déduite de la requête)
PUBLIC_URL=http://localhost:5190

# Jeton pour piloter l'admin par l'API (skill questionnaire de Claude), 32 caractères min.
ADMIN_API_TOKEN=

# Stockage S3 (images des questionnaires, fichiers joints par les répondants).
# En local : le RustFS du docker-compose ; S3_CREATE_BUCKET=true crée le bucket au démarrage.
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=questionnaire
S3_ACCESS_KEY_ID=questionnaire
S3_SECRET_ACCESS_KEY=questionnaire
S3_CREATE_BUCKET=true
