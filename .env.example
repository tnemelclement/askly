# Base Postgres (docker compose up -d)
DATABASE_URL=postgresql://askly:askly@localhost:5436/askly

# Clé de l'API Anthropic (jamais dans un fichier suivi)
ANTHROPIC_API_KEY=

# Propriétaire de l'instance (plan illimité) : connexion à /admin avec cet e-mail et ce mot de passe
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Clé de signature des sessions et jetons OAuth, 32 caractères min. (à défaut : dérivée d'ADMIN_PASSWORD)
SECRET_KEY=

# SaaS : inscription ouverte (essai de 14 jours) et abonnements Stripe (les quatre STRIPE_* ensemble).
# Webhook Stripe : https://<domaine>/api/stripe/webhook, événements checkout.session.completed
# et customer.subscription.created / updated / deleted.
SIGNUP=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_PRO=

# Ports de dev (le front Vite relaie /api vers l'API)
API_PORT=3400
WEB_PORT=5190

# Adresse publique, pour les liens renvoyés par l'API (sinon déduite de la requête)
PUBLIC_URL=http://localhost:5190

# Jeton pour piloter l'admin par l'API (serveur MCP et skill askly de Claude), 32 caractères min.
ADMIN_API_TOKEN=

# Stockage S3 (images des questionnaires, fichiers joints par les répondants).
# En local : le RustFS du docker-compose ; S3_CREATE_BUCKET=true crée le bucket au démarrage.
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=askly
S3_ACCESS_KEY_ID=askly
S3_SECRET_ACCESS_KEY=askly
S3_CREATE_BUCKET=true
