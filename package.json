{
  "name": "questionnaire",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @questionnaire/db generate",
    "db:migrate": "pnpm --filter @questionnaire/db migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  }
}
